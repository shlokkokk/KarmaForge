# KarmaForge Multi-Account Credentials & AI Pool Configuration
# Fill in your values below. NEVER commit or share your real .env file!

# ==============================================================================
# 1. AI API POOL (Keypool Rotation + Cascade)
# ==============================================================================
# Gemini keys (comma-separated for keypool rotation on rate-limits)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Groq Backup API Key (LPU failover when Gemini quota is exhausted)
GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# 2. REDDIT ACCOUNTS (Browser Session Cookie Auth)
# ==============================================================================
# Account 1
REDDIT_ACCOUNT_1_ENABLED=true
REDDIT_ACCOUNT_1_USERNAME=your_username_1
REDDIT_ACCOUNT_1_SESSION=your_reddit_session_cookie_1

# Account 2
REDDIT_ACCOUNT_2_ENABLED=true
REDDIT_ACCOUNT_2_USERNAME=your_username_2
REDDIT_ACCOUNT_2_SESSION=your_reddit_session_cookie_2

# ==============================================================================
# 3. DISCORD MISSION CONTROL BOT
# ==============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
