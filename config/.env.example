# KarmaForge Multi-Account Credentials & AI Pool Configuration
# Fill in your values below. NEVER commit or share this file!

# ==============================================================================
# 1. AI API POOL (Keypool Rotation + Cascade)
# ==============================================================================
# Gemini keys (comma-separated for Mika-style keypool rotation on 429 rate-limits)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Groq Backup Brain API Key (Llama-3.3-70b failover when Gemini quota is exhausted)
GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# 2. REDDIT ACCOUNT 1: jakee-peraltaa
# ==============================================================================
# Method: Browser Session Cookie (F12 -> Application -> Cookies -> reddit_session)
REDDIT_ACCOUNT_1_ENABLED=true
REDDIT_ACCOUNT_1_USERNAME=jakee-peraltaa
REDDIT_ACCOUNT_1_SESSION=your_reddit_session_cookie_here

# ==============================================================================
# 3. REDDIT ACCOUNT 2: jamieee_e
# ==============================================================================
# Method: Browser Session Cookie (F12 -> Application -> Cookies -> reddit_session)
REDDIT_ACCOUNT_2_ENABLED=true
REDDIT_ACCOUNT_2_USERNAME=jamieee_e
REDDIT_ACCOUNT_2_SESSION=your_reddit_session_cookie_here

# ==============================================================================
# 4. DISCORD MISSION CONTROL (Optional)
# ==============================================================================
# Webhook URL for real-time activity logs, karma milestones, and downvote alerts
DISCORD_WEBHOOK_URL=
